PORT=4000
JWT_SECRET=change_me_before_production
MONGODB_URI=mongodb://localhost:27017/imprint

# Comma-separated list of allowed CORS origins (production/custom frontend domains).
# localhost dev ports and capacitor://localhost are always allowed. Vercel
# deployments are allowed only when the hostname matches the project slug below
# (so previews work without allowing every *.vercel.app site).
ALLOWED_ORIGINS=https://imprint-wheat.vercel.app
# Vercel project slug used to match this project's *.vercel.app deployments.
VERCEL_PROJECT_SLUG=imprint

# Email (Brevo transactional API — see README for setup)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_USER=donotreply.imprint@gmail.com   # used as the "from" address

# Admin panel password — use a long, random value in production
ADMIN_PASSWORD=change_me_before_production
